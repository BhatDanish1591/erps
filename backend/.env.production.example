# ==============================================================================
# EduSaaS CRM - Backend Production Environment Variables
# NEVER run with DEBUG=true or default SECRET_KEY in production!
# ==============================================================================

APP_NAME="EduSaaS CRM"
APP_VERSION="1.0.0"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_64_CHAR_HEX_SECRET_FOR_JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Use POSTGRES_APP_USER, POSTGRES_APP_PASSWORD and POSTGRES_DB from the root file.
DATABASE_URL=postgresql+asyncpg://edusaas_app:CHANGE_ME_APP_PASSWORD@postgres:5432/edusaas_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Redis Cache & Queues (password protected)
REDIS_URL=redis://:CHANGE_ME_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_PASSWORD@redis:6379/2

# Production CORS & Allowed Hosts
ALLOWED_ORIGINS=https://edusaas.com,https://*.edusaas.com
ALLOWED_HOSTS=edusaas.com,*.edusaas.com,backend

# Storage Backend: 's3' or 'r2' (Do not use 'local' in multi-instance production!)
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=AKIA_PRODUCTION_KEY_ID
AWS_SECRET_ACCESS_KEY=PRODUCTION_SECRET_KEY
AWS_S3_BUCKET=edusaas-production-assets
AWS_REGION=ap-south-1

# Cloudflare R2 (Alternative to AWS S3)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Transactional Email: Amazon SES or Resend
EMAIL_BACKEND=ses
RESEND_API_KEY=
SES_REGION=ap-south-1
SES_FROM_EMAIL=no-reply@edusaas.com

# SMS & OTP Provider (MSG91)
MSG91_AUTH_KEY=CHANGE_ME_MSG91_AUTH_KEY
MSG91_SENDER_ID=EDUSAAS
MSG91_TEMPLATE_ID=CHANGE_ME_OTP_TEMPLATE_ID

# WhatsApp Meta Cloud API
META_WHATSAPP_TOKEN=CHANGE_ME_PERMANENT_META_SYSTEM_USER_TOKEN
META_PHONE_NUMBER_ID=CHANGE_ME_WHATSAPP_PHONE_NUMBER_ID
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_WHATSAPP_WEBHOOK_TOKEN

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_PROD_KEY_ID
RAZORPAY_KEY_SECRET=PROD_SECRET_KEY
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_RAZORPAY_WEBHOOK_SECRET

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_CREDENTIALS_PATH=/app/credentials/firebase-service-account.json

# APNs Push Notifications (iOS)
APNS_KEY_PATH=/app/credentials/AuthKey_APNS.p8
APNS_KEY_ID=ABC123XYZ
APNS_TEAM_ID=TEAMID12345
APNS_BUNDLE_ID=com.edusaas.crm

# Sentry Production Error Tracking & APM
SENTRY_DSN=https://example_key@o000000.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
