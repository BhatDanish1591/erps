# ==============================================================================
# EduSaaS CRM - Root Production Environment Variables
# NEVER commit the actual .env.production file to version control!
# Generate passwords using: openssl rand -hex 32
# ==============================================================================

# Database Credentials
POSTGRES_DB=edusaas_prod
POSTGRES_USER=edusaas_admin
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD_32_CHARS
POSTGRES_APP_USER=edusaas_app
POSTGRES_APP_PASSWORD=CHANGE_ME_GENERATE_SEPARATE_APP_PASSWORD

# Redis Cache & Broker
REDIS_PASSWORD=CHANGE_ME_GENERATE_SECURE_REDIS_PASSWORD_32_CHARS

# Domain & SSL Settings
DOMAIN_NAME=edusaas.com
LETSENCRYPT_EMAIL=ops@edusaas.com

# Node & Build Environment
NODE_ENV=production
