# ==============================================================================
# EduSaaS CRM - Web Frontend Production Environment Variables
# Baked into Vite static bundle at build time
# ==============================================================================

# API Base URL (Relative path proxied via Nginx)
VITE_API_URL=/api/v1

# Sentry DSN for Frontend Error Tracking
VITE_SENTRY_DSN=https://example_key@o000000.ingest.sentry.io/0000000

# App Version
VITE_APP_VERSION=1.0.0
